---
/** Archive card (GenerateBlocks "dynamic content template"): grid card, or the full-width first post of the homepage. */
import { Image } from "emdash/ui";
import AuthorLinks from "./AuthorLinks.astro";
import { postUrl, credits, categoryOf, excerpt, type Entry } from "../se/site";
interface Props { entry: Entry; variant?: "grid" | "first" }
const { entry, variant = "grid" } = Astro.props;
const cat = categoryOf(entry);
const first = variant === "first";
const fi = entry.data.featured_image;
const url = postUrl(entry.id);
---
{first ? (
<article id={`post-${entry.data.id}`} class:list={["dynamic-content-template post type-post status-publish format-standard has-post-thumbnail hentry", cat && `category-${cat.slug}`, "generate-columns tablet-grid-50 mobile-grid-100 grid-parent grid-100 featured-column"]}>
<div class="wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex"><div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow" style="flex-basis:100%"></div></div>
<a href={url}>{fi?.src && <Image image={fi} width={1280} height={720} alt={fi.alt || entry.data.title} class="gb-media-dcd63dc2 sp-no-webp" priority />}</a>
<div style="height:20px" aria-hidden="true" class="wp-block-spacer"></div>
<h2 class="gb-text gb-text-dc4dac1e"><a href={url}>{entry.data.title}</a></h2>
<div style="font-size: 18px;"><AuthorLinks bylines={credits(entry)} /></div>
<div style="height:10px" aria-hidden="true" class="wp-block-spacer"></div>
<p class="gb-text gb-text-7fb6cf2d">{excerpt(entry)}</p>
</article>
) : (
<article id={`post-${entry.data.id}`} class:list={["dynamic-content-template post type-post status-publish format-standard has-post-thumbnail hentry", cat && `category-${cat.slug}`, "generate-columns tablet-grid-50 mobile-grid-100 grid-parent grid-50"]}>
<div>
<a href={url}>{fi?.src && <Image image={fi} width={1280} height={720} alt={fi.alt || entry.data.title} class="gb-media-f4b1d94b sp-no-webp" />}</a>
<div class="gb-element-4b1f01c5">
<div style="height:13px" aria-hidden="true" class="wp-block-spacer"></div>
<h2 class="gb-text gb-text-b1a124d0"><a href={url}>{entry.data.title}</a></h2>
<div style="font-size: 18px;"><AuthorLinks bylines={credits(entry)} /></div>
<div style="height:10px" aria-hidden="true" class="wp-block-spacer"></div>
<p class="gb-text gb-text-e4c86b08">{excerpt(entry)}</p>
<div style="height:0px" aria-hidden="true" class="wp-block-spacer"></div>
<div style="height:0px" aria-hidden="true" class="wp-block-spacer"></div>
</div>
</div>
</article>
)}
