---
/** Archive pages (home, category, tag, author) from EmDash queries: 15 cards + 14 list items on the homepage,
 *  16 cards on term/author archives, offset pagination with Prev/Next like the live GenerateBlocks loop. */
import Sidebar from "../components/Sidebar.astro";
import SE from "../layouts/SE.astro";
import Card from "../components/Card.astro";
import MoreList from "../components/MoreList.astro";
import ArchiveNav from "../components/ArchiveNav.astro";
import AuthorBox from "../components/AuthorBox.astro";
import MostRead from "../components/MostRead.astro";
import { mostRead } from "./queries";
import { SITE, SITE_TITLE, SITE_DESCRIPTION, type Entry, type Term, type Byline } from "./site";
import seBooks from "./partials/home-se-books.html?raw";
export type ListingKind = "home" | "category" | "tag" | "author";
interface Props { kind: ListingKind; slug?: string | null; page: number; term?: Term | null; byline?: Byline | null; entries: Entry[]; hasNext: boolean }
const { kind, slug = null, page, term = null, byline = null, entries: shown, hasNext } = Astro.props;
const cards = kind === "home" && page === 1 ? shown.slice(0, 15) : shown;
const more = kind === "home" && page === 1 ? shown.slice(15) : [];

const base = kind === "home" ? SITE : kind === "author" ? `${SITE}/author/${slug}` : `${SITE}/${kind}/${slug}`;
const canonical = page === 1 ? (kind === "home" ? `${base}/` : base) : `${base}/page/${page}`;
const prev = page <= 1 ? null : page === 2 ? (kind === "home" ? SITE : base) : `${base}/page/${page - 1}`;
const next = hasNext ? `${base}/page/${page + 1}` : null;
const common = "wp-embed-responsive wp-theme-generatepress post-image-above-header post-image-aligned-left generate-columns-activated slideout-enabled slideout-mobile sticky-menu-slide right-sidebar nav-float-right one-container header-aligned-left dropdown-hover";
const paged = page > 1 ? ` - Page ${page}` : "";
const bodyClass = kind === "home" ? `home blog${page > 1 ? ` paged paged-${page}` : ""} ${common}` : kind === "author" ? `archive author author-${slug} ${common}` : `archive ${kind} ${kind}-${slug} ${common}`;
const title = kind === "home" ? (page > 1 ? `${SITE_TITLE}${paged}` : SITE_TITLE) : kind === "author" ? `Author: ${byline!.displayName}${paged} - ${SITE_TITLE}` : `${kind === "category" ? "Category" : "Tag"}: ${term!.label}${paged} - ${SITE_TITLE}`;
const description = kind === "home" ? SITE_DESCRIPTION : kind === "author" ? byline!.bio : kind === "category" ? (term!.description ?? null) : null;
const feed = kind === "home" ? null : { title: kind === "author" ? `Posts by ${byline!.displayName} Feed` : `${term!.label} ${kind === "category" ? "Category" : "Tag"} Feed`, href: `${base}/feed` };
const top = kind === "home" && page === 1 ? await mostRead(10) : [];
---
<SE title={title} description={description} canonical={canonical} prev={prev} next={next} feed={feed} bodyClass={bodyClass} siteTitleHeading={kind === "home" && page === 1}>
	<div class="generate-columns-container ">
		{kind === "category" && <header class="page-header" aria-label="Page"><h1 class="page-title">{term!.label}</h1>{term!.description && <div class="taxonomy-description"><p>{term!.description}</p></div>}</header>}
		{kind === "tag" && <header class="page-header" aria-label="Page"><h1 class="page-title">{term!.label}</h1></header>}
		{kind === "author" && <AuthorBox byline={byline!} />}
		{cards.map((e, i) => <Card entry={e} variant={kind === "home" && page === 1 && i === 0 ? "first" : "grid"} />)}
	</div>
	{more.length > 0 && <MoreList entries={more} />}
	<ArchiveNav prev={prev} next={next} />
	<Sidebar slot="sidebar" home={kind === "home" && page === 1} />
	{kind === "home" && page === 1 && <Fragment slot="after"><MostRead entries={top} /><Fragment set:html={seBooks} /></Fragment>}
</SE>
