---
/** Portable Text `htmlBlock` renderer for the site's own tidy HTML elements (Key Insights <details>, sponsor notes,
 *  content boxes, figures with linked captions, embeds): EmDash's default sanitiser would drop <details>/<iframe>
 *  attributes; the blocks come from tools/clean_content.mjs, not from user input, and are rendered as-is. */
interface Props { node: { _type: "htmlBlock"; _key: string; html: string } }
const { node } = Astro.props;
---
<Fragment set:html={node?.html ?? ""} />
