---
import SE from "../layouts/SE.astro";
import sidebar from "../se/partials/sidebar.html?raw";
import { renderHead } from "../se/head";
Astro.response.status = 404;
const bodyClass = "error404 wp-embed-responsive wp-theme-generatepress post-image-above-header post-image-aligned-left slideout-enabled slideout-mobile sticky-menu-slide right-sidebar nav-float-right one-container header-aligned-left dropdown-hover";
const main = `<div class="inside-article">\n\t\t\t<header class="entry-header">\n\t\t\t\t<h1 class="entry-title">Oops! That page can&#8217;t be found.</h1>\n\t\t\t</header>\n\n\t\t\t<div class="entry-content">\n\t\t\t\t<p>It looks like nothing was found at this location. Maybe try searching?</p>\n\t\t\t\t<form method="get" class="search-form" action="https://www.socialeurope.eu/">\n\t\t\t\t\t<label>\n\t\t\t\t\t\t<span class="screen-reader-text">Search for:</span>\n\t\t\t\t\t\t<input type="search" class="search-field" placeholder="Search &hellip;" value="" name="s" title="Search for:">\n\t\t\t\t\t</label>\n\t\t\t\t\t<button class="search-submit" aria-label="Search"><span class="gp-icon icon-search"><svg viewBox="0 0 512 512" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em"><path fill-rule="evenodd" clip-rule="evenodd" d="M208 48c-88.366 0-160 71.634-160 160s71.634 160 160 160 160-71.634 160-160S296.366 48 208 48zM0 208C0 93.125 93.125 0 208 0s208 93.125 208 208c0 48.741-16.765 93.566-44.843 129.024l133.826 134.018c9.366 9.379 9.355 24.575-.025 33.941-9.379 9.366-24.575 9.355-33.941-.025L337.238 370.987C301.747 399.167 256.839 416 208 416 93.125 416 0 322.875 0 208z" /></svg></span></button>\n\t\t\t\t</form>\n\t\t\t</div>\n\t\t</div>`;
---
<SE head={renderHead({ kind: "notfound", title: "Page not found - Social Europe", ogTitle: "Page not found", canonical: "https://www.socialeurope.eu/404", robots: "noindex,max-snippet:-1,max-image-preview:large,max-video-preview:-1", breadcrumbs: [{ name: "Page not found" }], publisherFull: true })} title="Page not found - Social Europe" bodyClass={bodyClass}>
	<Fragment set:html={main} />
	<Fragment slot="sidebar" set:html={sidebar} />
</SE>
