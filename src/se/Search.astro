---
/** Search results at /?s=<query> (snippet 35 markup) on EmDash full-text search. */
import { search, getEmDashEntry, getBylineBySlug } from "emdash";
import { Image } from "emdash/ui";
import Sidebar from "../components/Sidebar.astro";
import SE from "../layouts/SE.astro";
import AuthorLinks from "../components/AuthorLinks.astro";
import Avatar from "../components/Avatar.astro";
import { SITE, SITE_TITLE, postUrl, authorUrl, categoryUrl, credits, type Entry, type Byline } from "./site";
import { ordinalDate } from "./format";
interface Props { q: string; page: number }
const { q, page } = Astro.props;
const PER = 16;
const res = await search(q, { collections: ["posts"], limit: PER * page });
const all = ((res as { items?: unknown[]; results?: unknown[] }).items ?? (res as { results?: unknown[] }).results ?? []) as { slug: string }[];
const total = (res as { total?: number }).total ?? all.length;
const pages = Math.max(1, Math.ceil(total / PER));
const entries: Entry[] = [];
for (const r of all.slice((page - 1) * PER, page * PER)) { const { entry } = await getEmDashEntry("posts", r.slug); if (entry) entries.push(entry as unknown as Entry); }
const qn = q.trim().toLowerCase();
const author = qn ? ((await getBylineBySlug(qn.replace(/\s+/g, "-"))) as unknown as Byline | null) : null;
const title = `Search Results for “${q}” - ${SITE_TITLE}`;
const bodyClass = "search search-results wp-embed-responsive wp-theme-generatepress post-image-above-header post-image-aligned-left slideout-enabled slideout-mobile sticky-menu-slide right-sidebar nav-float-right one-container header-aligned-left dropdown-hover";
const pageHref = (n: number) => `${SITE}/${n <= 1 ? "" : `page/${n}`}?s=${encodeURIComponent(q)}`;
---
<SE title={title} canonical={pageHref(page)} robots="noindex,max-snippet:-1,max-image-preview:large,max-video-preview:-1" bodyClass={bodyClass}>
	{author && <div class="se-author-profile-box se-author-profile se-sr-card se-sr-card--author"><h4 class="se-box-header">Author profile</h4><div class="se-box-inner"><div class="se-author-avatar"><Avatar byline={author} eager /></div><div class="se-author-text"><h3 class="se-author-name-title"><a href={authorUrl(author.slug)}>{author.displayName}</a></h3><div class="se-author-bio-text">{author.bio && <p>{author.bio}</p>}<p class="se-sr-card__meta"><a class="se-sr-card__link" href={authorUrl(author.slug)}>Author page <span aria-hidden="true">&rarr;</span></a></p></div></div></div></div>}
	<header class="page-header se-sr-header" aria-label="Page"><h1 class="page-title se-sr-title">Search results for <strong>&ldquo;{q}&rdquo;</strong></h1></header>
	{entries.map((e) => { const cats = e.data.terms?.category ?? []; const fi = e.data.featured_image; return (
	<article id={`post-${e.data.id}`} class:list={["post type-post status-publish format-standard has-post-thumbnail hentry", ...cats.map((c) => `category-${c.slug}`)]} itemtype="https://schema.org/CreativeWork" itemscope>
<div class="inside-article">
<header class="entry-header">
<h2 class="entry-title" itemprop="headline"><a href={postUrl(e.id)} rel="bookmark">{e.data.title}</a></h2>
<div class="entry-meta">
<span class="posted-on"><time class="entry-date published" datetime={e.data.publishedAt?.toISOString().replace(/\.\d{3}Z$/, "+00:00")} itemprop="datePublished">{e.data.publishedAt ? ordinalDate(e.data.publishedAt) : ""}</time></span> <span class="byline"><AuthorLinks bylines={credits(e)} /></span> <span class="cat-links">{cats.map((c, i) => <>{i > 0 && ", "}<a href={categoryUrl(c.slug)} rel="category tag">{c.label}</a></>)}</span>
</div>
</header>
<a class="se-sr-thumb" href={postUrl(e.id)} tabindex="-1" aria-hidden="true">{fi?.src && <Image image={fi} width={1280} height={720} alt={fi.alt || e.data.title} />}</a>
<div class="entry-summary">
<p>{e.data.excerpt ?? ""}</p>
</div>
</div>
</article>); })}
	{pages > 1 && <nav class="se-sr-pagination" aria-label="Search results pages"><span class="se-sr-pagination__count">Page {page} of {pages}</span><span class="se-sr-pagination__links">{page > 1 && <a href={pageHref(page - 1)}><span aria-hidden="true">&larr;</span> Newer Articles</a>}{page < pages && <a href={pageHref(page + 1)}>Older Articles <span aria-hidden="true">&rarr;</span></a>}</span></nav>}
	<Sidebar slot="sidebar" />
</SE>
