---
/** Social Europe page skeleton: GeneratePress markup frozen from the live site (spike 1). Two frozen stylesheets: WordPress emitted
 *  merged-header rules (white nav icons) only on single posts and different column widths for pages without a sidebar, so there
 *  are three frozen stylesheets: article, site (with sidebar) and nosidebar. */
import headerInner from "../se/partials/header-inner.html?raw";
import footer from "../se/partials/footer.html?raw";
import slideout from "../se/partials/slideout.html?raw";
import slideoutOverlay from "../se/partials/slideout-overlay.html?raw";
import nsHighlight from "../se/partials/ns-highlight.html?raw";
import gpScripts from "../se/partials/gp-inline-scripts.html?raw";
import awrm from "../se/partials/awrm-rotation.html?raw";
import plausible from "../se/partials/head-plausible.html?raw";
import icons from "../se/partials/head-icons.html?raw";

interface Props { head: string; share?: string; title: string; description?: string | null; canonical: string; bodyClass: string; image?: string | null; type?: "website" | "article"; content?: { collection: string; id: string; slug?: string | null }; mergedHeader?: boolean; robots?: string | null; stylesheet?: "article" | "site" | "nosidebar"; }
const { head, title, bodyClass, share, mergedHeader = false, stylesheet } = Astro.props;
const css = stylesheet ?? (mergedHeader ? "article" : "site");
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
<Fragment set:html={head} />
<link rel="stylesheet" href={`/se/frozen-${css}.css`} />
<Fragment set:html={plausible} />
<Fragment set:html={icons} />
</head>
<body class={bodyClass}>
{mergedHeader ? <div class="header-wrap"><Fragment set:html={headerInner} /></div> : <Fragment set:html={headerInner} />}
<slot name="hero" />
<div id="page" class="site grid-container container hfeed">
	<div id="content" class="site-content">
		<div id="primary" class="content-area">
			<main class="site-main" id="main">
				<slot />
			</main>
		</div>
		<slot name="sidebar" />
	</div>
</div>
<slot name="after" />
<Fragment set:html={footer} />
<Fragment set:html={slideout} />
<Fragment set:html={slideoutOverlay} />
{share && <Fragment set:html={share} />}
<Fragment set:html={gpScripts} />
<script is:inline src="/se/offside.min.js"></script>
<Fragment set:html={awrm} />
<script is:inline src="/se/menu.min.js"></script>
<script is:inline src="/se/accordion.js"></script>
{mergedHeader && <Fragment set:html={nsHighlight} />}
</body>
</html>
