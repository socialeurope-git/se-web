---
/** Root-level slugs: a post, else a page (WordPress kept both directly under /). */
import { getEmDashEntry, decodeSlug } from "emdash";
import Article from "../se/Article.astro";
import Page from "../se/Page.astro";
const slug = decodeSlug(Astro.params.slug);
if (!slug) return new Response(null, { status: 404 });
const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
let page = null;
if (!post) {
	const r = await getEmDashEntry("pages", slug);
	if (!r.entry) return new Response(null, { status: 404 });
	page = r.entry; if (Astro.cache?.enabled) Astro.cache.set(r.cacheHint);
} else if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---
{post ? <Article post={post as never} /> : <Page page={page as never} />}
